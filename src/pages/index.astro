---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroBuilder from '../assets/hero-builder.png';

const LATEST_JSON_URL = 'https://storage.googleapis.com/dragbuilder-io-releases/releases/latest.json';

// Fallback in case the build-time fetch fails (e.g. offline build) — last known good release.
let releases = {
  version: '1.4.0',
  mac: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-mac.dmg' },
  windows: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-win.msi' },
  linux: {
    deb: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-linux.deb' },
    rpm: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-linux.rpm' },
  },
};

try {
  const res = await fetch(LATEST_JSON_URL);
  if (res.ok) releases = await res.json();
} catch {
  // keep fallback above
}

const features = [
  {
    title: 'Design by dragging, not coding',
    body: 'Build your screens visually from a library of ready-made pieces — buttons, forms, lists and more. No technical knowledge needed.',
  },
  {
    title: 'A real app, not a mockup',
    body: 'What you design actually works — it’s not a prototype or a preview. You get a genuine, functioning app underneath.',
  },
  {
    title: 'One app, every device',
    body: 'Build once and it runs on Desktop, Android, iPhone and the Web — no extra work to reach each one separately.',
  },
  {
    title: 'AI does the hard part',
    body: 'Describe what you want in plain language, and let the built-in AI put together the screens and logic for you.',
  },
  {
    title: 'Connect your data',
    body: 'Add logins, a database, or outside services to your app without any technical setup.',
  },
  {
    title: 'It’s really yours',
    body: 'Export your project whenever you want. Nothing hidden, nothing proprietary keeping you locked in.',
  },
];
---

<Layout>
  <!-- Nav -->
  <header class="sticky top-0 z-50 border-b border-border-strong bg-surface/80 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-text-primary">
        <span class="flex h-7 w-7 items-center justify-center rounded-[var(--radius-md)] bg-lime text-sm font-bold text-text-inverse">D</span>
        DragBuilder
      </a>
      <div class="hidden items-center gap-8 text-sm text-text-secondary md:flex">
        <a href="#features" class="hover:text-text-primary">Features</a>
        <a href="#download" class="hover:text-text-primary">Download</a>
        <a href="https://docs.dragbuilder.io" class="hover:text-text-primary">Docs</a>
      </div>
      <orbit-button href="https://app.dragbuilder.io" size="sm" variant="light">Open app</orbit-button>
    </nav>
  </header>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 h-[560px] bg-[radial-gradient(ellipse_at_top,_color-mix(in_srgb,_var(--color-lime)_18%,_transparent),_transparent_60%)]"
    >
    </div>
    <div class="relative mx-auto max-w-5xl px-6 pt-24 pb-16 text-center">
      <orbit-badge label="No code needed" size="md"></orbit-badge>
      <h1 class="mt-6 text-balance text-5xl font-semibold tracking-tight text-text-primary sm:text-6xl">
        Build real apps by <span class="text-lime">dragging</span>, not coding.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-text-secondary">
        DragBuilder lets anyone design an app just by dragging and dropping — no technical background
        needed. Build your screens, connect your data, and launch on Desktop, Android, iPhone and the Web,
        all from one project.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <orbit-button
          href="https://app.dragbuilder.io"
          size="md"
          trailing-icon="arrow-right"
          class="w-full justify-center sm:w-auto"
        >
          Try it in your browser
        </orbit-button>
        <div id="hero-download-wrap" class="w-full sm:w-auto">
          <orbit-button href="#download" size="md" variant="secondary" class="w-full justify-center sm:w-auto">Download DragBuilder</orbit-button>
        </div>
      </div>
      <p class="mt-4 text-xs text-text-muted">Free to start. No credit card required.</p>
    </div>

    <!-- Product screenshot — the actual builder canvas, not a mockup -->
    <div class="relative mx-auto max-w-5xl px-6 pb-24">
      <div class="overflow-hidden rounded-card border border-border-strong bg-surface-sunken shadow-2xl">
        <Image
          src={heroBuilder}
          alt="The DragBuilder canvas: a library of ready-made pieces on the left, a live preview of the real app in the center, and its settings on the right."
          width={2000}
          height={1414}
          loading="eager"
          class="w-full"
        />
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="mx-auto max-w-6xl px-6 py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-text-primary sm:text-4xl">Everything you need to ship</h2>
      <p class="mt-4 text-text-secondary">From first screen to production build, without leaving the canvas.</p>
    </div>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <orbit-card>
            <h3 class="font-semibold text-text-primary">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary">{f.body}</p>
          </orbit-card>
        ))
      }
    </div>
  </section>

  <!-- Download -->
  <section id="download" class="border-t border-border-strong bg-surface-secondary/20">
    <div class="mx-auto max-w-5xl px-6 py-24 text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-text-primary sm:text-4xl">Get DragBuilder</h2>

      <!-- Desktop installers — hidden by JS on phones/tablets, where none of these
           can actually be installed; those visitors see #mobile-download-fallback instead. -->
      <div id="desktop-download-ui">
        <p class="mt-4 text-text-secondary">Free to start. Available for macOS, Windows and Linux.</p>

        <div class="mt-12 flex flex-col items-center gap-4">
          <orbit-button id="primary-download" href={releases.mac.url} size="lg" leading-icon="download">
            Download for macOS
          </orbit-button>
          <p id="alt-downloads" class="text-xs text-text-muted">
            v{releases.version} · Also available for{' '}
            <a href={releases.windows.url} data-os="windows" class="text-text-secondary underline underline-offset-2 hover:text-text-primary">Windows</a>
            {' '}·{' '}
            <a href={releases.linux.deb.url} data-os="linux" class="text-text-secondary underline underline-offset-2 hover:text-text-primary">Linux</a>
          </p>
          <p id="linux-rpm-note" class="hidden text-xs text-text-muted">
            Fedora/RHEL? Grab the <a href={releases.linux.rpm.url} class="text-text-secondary underline underline-offset-2 hover:text-text-primary">.rpm</a> instead.
          </p>
        </div>

        <p class="mt-8 text-xs text-text-muted">
          Windows installer is currently unsigned — you may see a SmartScreen "unknown publisher" warning on first
          install.
        </p>
      </div>

      <!-- Phone/tablet fallback — none of the desktop installers above apply here. -->
      <div id="mobile-download-fallback" class="hidden">
        <p class="mt-4 max-w-md mx-auto text-text-secondary">
          The DragBuilder app is available for macOS, Windows and Linux — open this page on a computer to
          download it. From here, you can try DragBuilder right in your browser instead.
        </p>
        <div class="mt-8">
          <orbit-button href="https://app.dragbuilder.io" size="md" trailing-icon="arrow-right">
            Try it in your browser
          </orbit-button>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-border-strong">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-10 text-sm text-text-muted sm:flex-row">
      <p>&copy; {new Date().getFullYear()} DragBuilder</p>
      <div class="flex gap-6">
        <a href="https://app.dragbuilder.io" class="hover:text-text-secondary">Open app</a>
        <a href="https://docs.dragbuilder.io" class="hover:text-text-secondary">Docs</a>
      </div>
    </div>
  </footer>

  <script>
    import '@dragbuilder-io/orbit/orbit-button.js';
    import '@dragbuilder-io/orbit/orbit-badge.js';
    import '@dragbuilder-io/orbit/orbit-card.js';

    const ua = navigator.userAgent.toLowerCase();

    // None of the desktop installers below this point can be installed from a
    // phone or tablet — swap that whole section (and the hero's secondary
    // "Download" button) for a "try it in the browser instead" message.
    const isMobile = /android|iphone|ipad|ipod|mobile/.test(ua);

    if (isMobile) {
      document.getElementById('hero-download-wrap')?.classList.add('hidden');
      document.getElementById('desktop-download-ui')?.classList.add('hidden');
      document.getElementById('mobile-download-fallback')?.classList.remove('hidden');
    } else {
      // Progressive enhancement only — every download link already points at a real,
      // working URL server-rendered above (macOS as the primary button, Windows/Linux
      // as the two text links). This just swaps which platform is primary to match
      // the visitor's OS, so they don't have to think about which one to click.
      const primaryBtn = document.getElementById('primary-download');
      const altLinks = document.querySelectorAll<HTMLAnchorElement>('#alt-downloads a');

      const platforms: Record<string, { label: string; href: string }> = {
        mac: { label: 'macOS', href: primaryBtn?.getAttribute('href') ?? '' },
        windows: { label: 'Windows', href: altLinks[0]?.getAttribute('href') ?? '' },
        linux: { label: 'Linux', href: altLinks[1]?.getAttribute('href') ?? '' },
      };

      let detected = 'mac';
      if (ua.includes('win')) detected = 'windows';
      else if (ua.includes('linux')) detected = 'linux';

      const rest = Object.keys(platforms).filter((p) => p !== detected);

      if (primaryBtn) {
        primaryBtn.setAttribute('href', platforms[detected].href);
        primaryBtn.textContent = `Download for ${platforms[detected].label}`;
      }
      rest.forEach((p, i) => {
        const link = altLinks[i];
        if (!link) return;
        link.setAttribute('href', platforms[p].href);
        link.textContent = platforms[p].label;
      });

      // Only the .deb link is ever promoted to primary/alt — Fedora/RHEL users
      // need a way to reach the .rpm too, so surface it as a small extra note
      // instead of a third slot in the already-minimal button+links layout.
      if (detected === 'linux') {
        document.getElementById('linux-rpm-note')?.classList.remove('hidden');
      }
    }
  </script>
</Layout>
