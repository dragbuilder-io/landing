---
import Layout from '../layouts/Layout.astro';

const LATEST_JSON_URL = 'https://storage.googleapis.com/dragbuilder-io-releases/releases/latest.json';

// Fallback in case the build-time fetch fails (e.g. offline build) — last known good release.
let releases = {
  version: '1.4.0',
  mac: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-mac.dmg' },
  windows: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-win.msi' },
  linux: {
    deb: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-linux.deb' },
    rpm: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-linux.rpm' },
  },
};

try {
  const res = await fetch(LATEST_JSON_URL);
  if (res.ok) releases = await res.json();
} catch {
  // keep fallback above
}

const features = [
  {
    title: 'Drag-and-drop UI builder',
    body: 'Compose real Jetpack Compose screens visually from a live component palette — no boilerplate, no guesswork.',
  },
  {
    title: 'Real Kotlin, not a black box',
    body: 'Every screen generates clean, idiomatic Compose code you can read, extend, and own — nothing hidden behind a runtime.',
  },
  {
    title: 'One project, four platforms',
    body: 'Desktop, Android, iOS and Web from the same codebase, powered by Kotlin Multiplatform.',
  },
  {
    title: 'AI-assisted building',
    body: 'Describe what you want and let the built-in AI wire up screens, state and logic for you.',
  },
  {
    title: 'Firebase & APIs built in',
    body: 'Connect Firestore, Auth, and REST/GraphQL APIs without hand-writing integration boilerplate.',
  },
  {
    title: 'Own your code',
    body: 'Export a real Gradle project whenever you want. No lock-in, no proprietary runtime to migrate away from.',
  },
];
---

<Layout>
  <!-- Nav -->
  <header class="sticky top-0 z-50 border-b border-white/5 bg-slate-950/80 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-white">
        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-indigo-400 to-fuchsia-400 text-sm font-bold text-slate-950">D</span>
        DragBuilder
      </a>
      <div class="hidden items-center gap-8 text-sm text-slate-300 md:flex">
        <a href="#features" class="hover:text-white">Features</a>
        <a href="#download" class="hover:text-white">Download</a>
        <a href="https://docs.composeflow.io" class="hover:text-white">Docs</a>
      </div>
      <a
        href="https://app.dragbuilder.io"
        class="rounded-full bg-white px-4 py-2 text-sm font-medium text-slate-950 transition hover:bg-slate-200"
      >
        Open app
      </a>
    </nav>
  </header>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 h-[560px] bg-[radial-gradient(ellipse_at_top,_theme(colors.indigo.500/35%),_transparent_60%)]"
    >
    </div>
    <div class="relative mx-auto max-w-5xl px-6 pt-24 pb-20 text-center">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-medium text-slate-300"
      >
        Compose Multiplatform, visually
      </span>
      <h1 class="mt-6 text-balance text-5xl font-semibold tracking-tight text-white sm:text-6xl">
        Build real apps by <span class="bg-gradient-to-r from-indigo-400 to-fuchsia-400 bg-clip-text text-transparent">dragging</span>, not coding.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-400">
        DragBuilder is a visual UI builder for Kotlin Compose Multiplatform. Design your screens, wire up
        logic, and ship native apps for Desktop, Android, iOS and Web — with clean, readable Kotlin code
        underneath.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="#download"
          class="w-full rounded-full bg-gradient-to-r from-indigo-500 to-fuchsia-500 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-500/25 transition hover:opacity-90 sm:w-auto"
        >
          Download DragBuilder
        </a>
        <a
          href="https://app.dragbuilder.io"
          class="w-full rounded-full border border-white/15 px-7 py-3 text-sm font-semibold text-slate-200 transition hover:bg-white/5 sm:w-auto"
        >
          Try it in your browser →
        </a>
      </div>
      <p class="mt-4 text-xs text-slate-500">Free to start. No credit card required.</p>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="mx-auto max-w-6xl px-6 py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">Everything you need to ship</h2>
      <p class="mt-4 text-slate-400">From first screen to production build, without leaving the canvas.</p>
    </div>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-white/20 hover:bg-white/[0.05]">
            <h3 class="font-semibold text-white">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Download -->
  <section id="download" class="border-t border-white/5 bg-slate-900/40">
    <div class="mx-auto max-w-5xl px-6 py-24 text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">Get DragBuilder</h2>
      <p class="mt-4 text-slate-400">
        Available for macOS, Windows and Linux — version <span class="font-mono text-slate-300">{releases.version}</span>.
      </p>

      <div id="download-cards" class="mt-14 grid gap-6 sm:grid-cols-3">
        <div data-os="mac" class="download-card rounded-2xl border border-white/10 bg-white/[0.03] p-8 transition">
          <div class="text-3xl">🍎</div>
          <h3 class="mt-3 font-semibold text-white">macOS</h3>
          <p class="mt-1 text-xs text-slate-500">Apple Silicon &amp; Intel</p>
          <a
            href={releases.mac.url}
            class="download-btn mt-6 inline-block w-full rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-slate-200 transition hover:bg-white/5"
          >
            Download .dmg
          </a>
          <p class="recommended-badge mt-3 hidden text-xs font-medium text-indigo-300">Recommended for your system</p>
        </div>

        <div data-os="windows" class="download-card rounded-2xl border border-white/10 bg-white/[0.03] p-8 transition">
          <div class="text-3xl">🪟</div>
          <h3 class="mt-3 font-semibold text-white">Windows</h3>
          <p class="mt-1 text-xs text-slate-500">Windows 10 &amp; 11 (64-bit)</p>
          <a
            href={releases.windows.url}
            class="download-btn mt-6 inline-block w-full rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-slate-200 transition hover:bg-white/5"
          >
            Download .msi
          </a>
          <p class="recommended-badge mt-3 hidden text-xs font-medium text-indigo-300">Recommended for your system</p>
        </div>

        <div data-os="linux" class="download-card rounded-2xl border border-white/10 bg-white/[0.03] p-8 transition">
          <div class="text-3xl">🐧</div>
          <h3 class="mt-3 font-semibold text-white">Linux</h3>
          <p class="mt-1 text-xs text-slate-500">Debian/Ubuntu &amp; Fedora/RHEL</p>
          <div class="mt-6 flex gap-2">
            <a
              href={releases.linux.deb.url}
              class="download-btn flex-1 rounded-full border border-white/15 px-3 py-2.5 text-sm font-semibold text-slate-200 transition hover:bg-white/5"
            >
              .deb
            </a>
            <a
              href={releases.linux.rpm.url}
              class="download-btn flex-1 rounded-full border border-white/15 px-3 py-2.5 text-sm font-semibold text-slate-200 transition hover:bg-white/5"
            >
              .rpm
            </a>
          </div>
          <p class="recommended-badge mt-3 hidden text-xs font-medium text-indigo-300">Recommended for your system</p>
        </div>
      </div>

      <p class="mt-8 text-xs text-slate-500">
        Windows installer is currently unsigned — you may see a SmartScreen "unknown publisher" warning on first
        install.
      </p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-white/5">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-10 text-sm text-slate-500 sm:flex-row">
      <p>&copy; {new Date().getFullYear()} DragBuilder</p>
      <div class="flex gap-6">
        <a href="https://app.dragbuilder.io" class="hover:text-slate-300">Open app</a>
        <a href="https://docs.composeflow.io" class="hover:text-slate-300">Docs</a>
      </div>
    </div>
  </footer>

  <script>
    // Progressive enhancement only — every download link already points at a real,
    // working URL server-rendered above. This just highlights the card matching the
    // visitor's OS so they don't have to think about which one to click.
    const platform = navigator.userAgent.toLowerCase();
    let detected: string | null = null;
    if (platform.includes('mac')) detected = 'mac';
    else if (platform.includes('win')) detected = 'windows';
    else if (platform.includes('linux') && !platform.includes('android')) detected = 'linux';

    if (detected) {
      const card = document.querySelector(`.download-card[data-os="${detected}"]`);
      if (card) {
        card.classList.add('border-indigo-400/50', 'bg-indigo-500/[0.06]');
        card.querySelector('.recommended-badge')?.classList.remove('hidden');
        card.querySelectorAll<HTMLAnchorElement>('.download-btn').forEach((btn) => {
          btn.classList.remove('border', 'border-white/15', 'text-slate-200', 'hover:bg-white/5');
          btn.classList.add(
            'bg-gradient-to-r',
            'from-indigo-500',
            'to-fuchsia-500',
            'text-white',
            'shadow-lg',
            'shadow-indigo-500/25',
          );
        });
      }
    }
  </script>
</Layout>
