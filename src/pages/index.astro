---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroBuilder from '../assets/hero-builder.png';
import { iconMarkup } from '@dragbuilder-io/orbit/icons.js';

const LATEST_JSON_URL = 'https://storage.googleapis.com/dragbuilder-io-releases/releases/latest.json';

// Fallback in case the build-time fetch fails (e.g. offline build) — last known good release.
let releases = {
  version: '1.4.0',
  mac: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-mac.dmg' },
  windows: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-win.msi' },
  linux: {
    deb: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-linux.deb' },
    rpm: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-linux.rpm' },
  },
};

try {
  const res = await fetch(LATEST_JSON_URL);
  if (res.ok) releases = await res.json();
} catch {
  // keep fallback above
}

const platforms = [
  { label: 'Desktop', icon: 'monitor' },
  { label: 'Android', icon: 'smartphone' },
  { label: 'iPhone', icon: 'smartphone' },
  { label: 'Web', icon: 'globe' },
];

// First entry renders larger (sm:col-span-2) in the bento grid below — keep
// it first if you want it to stay the emphasized one.
const features = [
  {
    icon: 'sparkles',
    title: 'Describe it, AI builds it',
    body: 'Describe a screen — or a whole app — in plain language. AI generates the structure, the data model and the logic. You refine it from there by dragging, not by writing code.',
  },
  {
    icon: 'board',
    title: 'Design by dragging, not coding',
    body: 'Adjust anything visually from a library of ready-made pieces — buttons, forms, lists and more. No technical knowledge needed.',
  },
  {
    icon: 'check-circle',
    title: 'A real app, not a mockup',
    body: 'What you design actually works — it’s not a prototype or a preview. You get a genuine, functioning app underneath.',
  },
  {
    icon: 'globe',
    title: 'One app, every device',
    body: 'Build once and it runs on Desktop, Android, iPhone and the Web — no extra work to reach each one separately.',
  },
  {
    icon: 'database',
    title: 'Connect your data',
    body: 'Add logins, a database, or outside services to your app without any technical setup.',
  },
  {
    icon: 'unlock',
    title: 'It’s really yours',
    body: 'Export your project whenever you want. Nothing hidden, nothing proprietary keeping you locked in.',
  },
];

const faqs = [
  {
    question: 'Can AI really build a whole app, not just a screen?',
    answer:
      "Yes. Describe what you want and DragBuilder's built-in AI generates the screens, the data model and the logic behind them — you're not limited to one component or one page at a time.",
  },
  {
    question: 'Do I need to know how to code?',
    answer:
      'No. Everything AI generates — and everything you add or adjust afterward — is done by dragging and dropping from a library of ready-made pieces, not by writing code.',
  },
  {
    question: 'Is DragBuilder free?',
    answer:
      "Yes, it's free to start and no credit card is required. You can try it in your browser or download the desktop app for macOS, Windows or Linux.",
  },
  {
    question: 'Which platforms can I build for?',
    answer:
      "One project runs on Desktop, Android, iPhone and the Web — you don't need to design or build each one separately.",
  },
  {
    question: 'Am I locked into DragBuilder once I build something?',
    answer: "No. You can export your project whenever you want — nothing about what you build is hidden or proprietary.",
  },
];

const steps = [
  {
    title: 'Describe your app',
    body: 'Tell the built-in AI what you want to build — it drafts the first screens, data model and logic for you.',
  },
  {
    title: 'Refine it by dragging',
    body: 'Adjust anything AI drafted the same way you’d arrange sticky notes — drag, drop, connect the pieces that still need it.',
  },
  {
    title: 'Ship everywhere',
    body: 'One project, four targets — Desktop, Android, iPhone and the Web.',
  },
];
---

<Layout>
  <!-- Nav -->
  <header class="sticky top-0 z-50 border-b border-border-strong bg-surface/80 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-text-primary">
        <span class="flex h-7 w-7 items-center justify-center rounded-[var(--radius-md)] bg-lime text-sm font-bold text-text-inverse">D</span>
        DragBuilder
      </a>
      <div class="hidden items-center gap-8 text-sm text-text-secondary md:flex">
        <a href="#features" class="hover:text-text-primary">Features</a>
        <a href="#how" class="hover:text-text-primary">How it works</a>
        <a href="#faq" class="hover:text-text-primary">FAQ</a>
        <a href="#download" class="hover:text-text-primary">Download</a>
        <a href="https://docs.dragbuilder.io" class="hover:text-text-primary">Docs</a>
      </div>
      <div class="flex items-center gap-3">
        <orbit-theme-toggle id="theme-toggle" value="dark" aria-label="Theme"></orbit-theme-toggle>
        <orbit-button href="https://app.dragbuilder.io" size="sm" variant="light">Open app</orbit-button>
      </div>
    </nav>
  </header>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 h-[560px] bg-[radial-gradient(ellipse_at_top,_color-mix(in_srgb,_var(--color-lime)_18%,_transparent),_transparent_60%)]"
    >
    </div>

    <div class="relative mx-auto grid max-w-6xl gap-16 px-6 pt-20 pb-24 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <!-- copy -->
      <div>
        <orbit-badge label="AI-powered · No code" size="md"></orbit-badge>
        <h1 class="mt-6 text-balance text-5xl font-extrabold tracking-tight text-text-primary sm:text-6xl">
          Describe it. AI builds it. <span class="text-lime">Drag</span> to make it yours.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-text-secondary">
          DragBuilder's built-in AI generates your app's first screens, data model and logic from plain
          language — then you adjust anything by dragging and dropping, no technical background needed.
          Launch on Desktop, Android, iPhone and the Web, all from one project.
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <orbit-button
            href="https://app.dragbuilder.io"
            size="md"
            trailing-icon="arrow-right"
            class="w-full justify-center sm:w-auto"
          >
            Try it in your browser
          </orbit-button>
          <div id="hero-download-wrap" class="w-full sm:w-auto">
            <orbit-button href="#download" size="md" variant="light" class="w-full justify-center sm:w-auto">Download DragBuilder</orbit-button>
          </div>
        </div>
        <p class="mt-4 text-xs text-text-muted">Free to start. No credit card required.</p>
      </div>

      <!-- product screenshot — the actual builder canvas, layered for depth -->
      <div class="relative">
        <div
          aria-hidden="true"
          class="absolute -right-3 top-8 hidden h-[88%] w-[94%] rotate-2 rounded-card border border-border-strong bg-surface-card opacity-60 lg:block"
        >
        </div>
        <div class="relative overflow-hidden rounded-card border border-border-strong bg-surface-sunken shadow-2xl">
          <Image
            src={heroBuilder}
            alt="The DragBuilder canvas: a library of ready-made pieces on the left, a live preview of the real app in the center, and its settings on the right."
            width={2000}
            height={1414}
            loading="eager"
            class="w-full"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Platforms -->
  <section class="border-y border-border-strong">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-12 gap-y-3 px-6 py-7">
      {
        platforms.map((p) => (
          <span class="flex items-center gap-2.5 text-sm font-semibold text-text-muted">
            <span class="[&>svg]:h-[18px] [&>svg]:w-[18px]" set:html={iconMarkup(p.icon)} />
            {p.label}
          </span>
        ))
      }
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="mx-auto max-w-6xl px-6 py-24">
    <div class="max-w-2xl">
      <p class="text-xs font-bold tracking-wide text-lime uppercase">Everything you need to ship</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-text-primary sm:text-4xl">
        Built for people who think in screens, not syntax.
      </h2>
    </div>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f, i) => (
          <orbit-card
            class={i === 0 ? 'sm:col-span-2' : i === features.length - 1 ? 'sm:col-span-2 lg:col-span-3' : ''}
          >
            {i === features.length - 1 ? (
              <div class="flex items-center gap-5">
                <span
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-field bg-lime/10 text-lime [&>svg]:h-6 [&>svg]:w-6"
                  set:html={iconMarkup(f.icon)}
                />
                <div>
                  <h3 class="font-semibold text-text-primary">{f.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-text-secondary">{f.body}</p>
                </div>
              </div>
            ) : (
              <Fragment>
                <span
                  class="flex h-11 w-11 items-center justify-center rounded-field bg-lime/10 text-lime [&>svg]:h-6 [&>svg]:w-6"
                  set:html={iconMarkup(f.icon)}
                />
                <h3 class="mt-4 font-semibold text-text-primary">{f.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-text-secondary">{f.body}</p>
              </Fragment>
            )}
          </orbit-card>
        ))
      }
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="mx-auto max-w-6xl border-t border-border-strong px-6 py-24">
    <div class="mb-14 max-w-2xl">
      <p class="text-xs font-bold tracking-wide text-lime uppercase">How it works</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-text-primary sm:text-4xl">
        From idea to install in three drags.
      </h2>
    </div>
    <orbit-stepper>
      {steps.map((s) => <orbit-step state="active">{s.title}</orbit-step>)}
    </orbit-stepper>
    <div class="mt-4 grid gap-10 sm:grid-cols-3">
      {
        steps.map((s) => (
          <p class="text-center text-sm leading-relaxed text-text-secondary">{s.body}</p>
        ))
      }
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="mx-auto max-w-4xl border-t border-border-strong px-6 py-24">
    <div class="max-w-2xl">
      <p class="text-xs font-bold tracking-wide text-lime uppercase">FAQ</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-text-primary sm:text-4xl">Questions, answered.</h2>
    </div>
    <div class="mt-10 flex flex-col gap-3">
      {
        faqs.map((item) => (
          <details class="faq-item group rounded-panel border border-border-strong bg-surface-card px-6 py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-text-primary">
              {item.question}
              <span
                class="shrink-0 text-text-muted [&>svg]:h-4 [&>svg]:w-4"
                set:html={iconMarkup('chevron-down')}
              />
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-text-secondary">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  })} />

  <!-- Download -->
  <section id="download" class="mx-auto max-w-5xl px-6 py-24">
    <orbit-card>
    <div class="px-6 py-16 text-center sm:px-16">
      <h2 class="text-3xl font-semibold tracking-tight text-text-primary sm:text-4xl">Get DragBuilder</h2>

      <!-- Desktop installers — hidden by JS on phones/tablets, where none of these
           can actually be installed; those visitors see #mobile-download-fallback instead. -->
      <div id="desktop-download-ui">
        <p class="mt-4 text-text-secondary">Free to start. Available for macOS, Windows and Linux.</p>

        <div class="mt-12 flex flex-col items-center gap-4">
          <orbit-button id="primary-download" href={releases.mac.url} size="md" leading-icon="download">
            Download for macOS
          </orbit-button>
          <p id="alt-downloads" class="text-xs text-text-muted">
            v{releases.version} · Also available for{' '}
            <a href={releases.windows.url} data-os="windows" class="text-text-secondary underline underline-offset-2 hover:text-text-primary">Windows</a>
            {' '}·{' '}
            <a href={releases.linux.deb.url} data-os="linux" class="text-text-secondary underline underline-offset-2 hover:text-text-primary">Linux</a>
          </p>
          <p id="linux-rpm-note" class="hidden text-xs text-text-muted">
            Fedora/RHEL? Grab the <a href={releases.linux.rpm.url} class="text-text-secondary underline underline-offset-2 hover:text-text-primary">.rpm</a> instead.
          </p>
        </div>

        <p class="mt-8 text-xs text-text-muted">
          Windows installer is currently unsigned — you may see a SmartScreen "unknown publisher" warning on first
          install.
        </p>
      </div>

      <!-- Phone/tablet fallback — none of the desktop installers above apply here. -->
      <div id="mobile-download-fallback" class="hidden">
        <p class="mt-4 max-w-md mx-auto text-text-secondary">
          The DragBuilder app is available for macOS, Windows and Linux — open this page on a computer to
          download it. From here, you can try DragBuilder right in your browser instead.
        </p>
        <div class="mt-8">
          <orbit-button href="https://app.dragbuilder.io" size="md" trailing-icon="arrow-right">
            Try it in your browser
          </orbit-button>
        </div>
      </div>
    </div>
    </orbit-card>
  </section>

  <!-- Footer -->
  <footer class="border-t border-border-strong">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-10 text-sm text-text-muted sm:flex-row">
      <p>&copy; {new Date().getFullYear()} DragBuilder</p>
      <div class="flex gap-6">
        <a href="https://app.dragbuilder.io" class="hover:text-text-secondary">Open app</a>
        <a href="https://docs.dragbuilder.io" class="hover:text-text-secondary">Docs</a>
      </div>
    </div>
  </footer>

  <script>
    import '@dragbuilder-io/orbit/orbit-button.js';
    import '@dragbuilder-io/orbit/orbit-badge.js';
    import '@dragbuilder-io/orbit/orbit-card.js';
    import '@dragbuilder-io/orbit/orbit-theme-toggle.js';
    import '@dragbuilder-io/orbit/orbit-stepper.js';

    // Theme toggle — orbit-theme-toggle only owns the chrome (see its own
    // source comment), so each consumer wires its own storage key and
    // FOUC-prevention script; the inline script in Layout.astro's <head>
    // handles the FOUC part, this handles persistence + live updates.
    const THEME_KEY = 'dragbuilder-theme';
    type ThemeChoice = 'auto' | 'dark' | 'light';

    const parseChoice = (value: unknown): ThemeChoice =>
      value === 'dark' || value === 'light' ? value : 'auto';

    const loadChoice = (): ThemeChoice => parseChoice(localStorage.getItem(THEME_KEY));

    const resolve = (choice: ThemeChoice): 'dark' | 'light' =>
      choice === 'auto' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : choice;

    const themeToggle = document.getElementById('theme-toggle');

    function applyTheme(choice: ThemeChoice, persist: boolean): void {
      document.documentElement.dataset.theme = resolve(choice);
      themeToggle?.setAttribute('value', choice);
      if (persist) {
        if (choice === 'auto') localStorage.removeItem(THEME_KEY);
        else localStorage.setItem(THEME_KEY, choice);
      }
    }

    applyTheme(loadChoice(), false);

    themeToggle?.addEventListener('orbit-change', (event) => {
      applyTheme(parseChoice((event as CustomEvent<{ value: string }>).detail?.value), true);
    });

    matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
      if (loadChoice() === 'auto') applyTheme('auto', false);
    });

    const ua = navigator.userAgent.toLowerCase();

    // None of the desktop installers below this point can be installed from a
    // phone or tablet — swap that whole section (and the hero's secondary
    // "Download" button) for a "try it in the browser instead" message.
    const isMobile = /android|iphone|ipad|ipod|mobile/.test(ua);

    if (isMobile) {
      document.getElementById('hero-download-wrap')?.classList.add('hidden');
      document.getElementById('desktop-download-ui')?.classList.add('hidden');
      document.getElementById('mobile-download-fallback')?.classList.remove('hidden');
    } else {
      // Progressive enhancement only — every download link already points at a real,
      // working URL server-rendered above (macOS as the primary button, Windows/Linux
      // as the two text links). This just swaps which platform is primary to match
      // the visitor's OS, so they don't have to think about which one to click.
      const primaryBtn = document.getElementById('primary-download');
      const altLinks = document.querySelectorAll<HTMLAnchorElement>('#alt-downloads a');

      const platforms: Record<string, { label: string; href: string }> = {
        mac: { label: 'macOS', href: primaryBtn?.getAttribute('href') ?? '' },
        windows: { label: 'Windows', href: altLinks[0]?.getAttribute('href') ?? '' },
        linux: { label: 'Linux', href: altLinks[1]?.getAttribute('href') ?? '' },
      };

      let detected = 'mac';
      if (ua.includes('win')) detected = 'windows';
      else if (ua.includes('linux')) detected = 'linux';

      const rest = Object.keys(platforms).filter((p) => p !== detected);

      if (primaryBtn) {
        primaryBtn.setAttribute('href', platforms[detected].href);
        primaryBtn.textContent = `Download for ${platforms[detected].label}`;
      }
      rest.forEach((p, i) => {
        const link = altLinks[i];
        if (!link) return;
        link.setAttribute('href', platforms[p].href);
        link.textContent = platforms[p].label;
      });

      // Only the .deb link is ever promoted to primary/alt — Fedora/RHEL users
      // need a way to reach the .rpm too, so surface it as a small extra note
      // instead of a third slot in the already-minimal button+links layout.
      if (detected === 'linux') {
        document.getElementById('linux-rpm-note')?.classList.remove('hidden');
      }
    }
  </script>
</Layout>
