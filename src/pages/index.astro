---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroBuilder from '../assets/hero-builder.png';

const LATEST_JSON_URL = 'https://storage.googleapis.com/dragbuilder-io-releases/releases/latest.json';

// Fallback in case the build-time fetch fails (e.g. offline build) — last known good release.
let releases = {
  version: '1.4.0',
  mac: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-mac.dmg' },
  windows: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-win.msi' },
  linux: {
    deb: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-linux.deb' },
    rpm: { url: 'https://storage.googleapis.com/dragbuilder-io-releases/releases/1.4.0/DragBuilder-linux.rpm' },
  },
};

try {
  const res = await fetch(LATEST_JSON_URL);
  if (res.ok) releases = await res.json();
} catch {
  // keep fallback above
}

const features = [
  {
    title: 'Drag-and-drop UI builder',
    body: 'Compose real Jetpack Compose screens visually from a live component palette — no boilerplate, no guesswork.',
  },
  {
    title: 'Real Kotlin, not a black box',
    body: 'Every screen generates clean, idiomatic Compose code you can read, extend, and own — nothing hidden behind a runtime.',
  },
  {
    title: 'One project, four platforms',
    body: 'Desktop, Android, iOS and Web from the same codebase, powered by Kotlin Multiplatform.',
  },
  {
    title: 'AI-assisted building',
    body: 'Describe what you want and let the built-in AI wire up screens, state and logic for you.',
  },
  {
    title: 'Firebase & APIs built in',
    body: 'Connect Firestore, Auth, and REST/GraphQL APIs without hand-writing integration boilerplate.',
  },
  {
    title: 'Own your code',
    body: 'Export a real Gradle project whenever you want. No lock-in, no proprietary runtime to migrate away from.',
  },
];
---

<Layout>
  <!-- Nav -->
  <header class="sticky top-0 z-50 border-b border-border-strong bg-surface/80 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-text-primary">
        <span class="flex h-7 w-7 items-center justify-center rounded-[var(--radius-md)] bg-lime text-sm font-bold text-text-inverse">D</span>
        DragBuilder
      </a>
      <div class="hidden items-center gap-8 text-sm text-text-secondary md:flex">
        <a href="#features" class="hover:text-text-primary">Features</a>
        <a href="#download" class="hover:text-text-primary">Download</a>
        <a href="https://docs.dragbuilder.io" class="hover:text-text-primary">Docs</a>
      </div>
      <orbit-button href="https://app.dragbuilder.io" size="sm" variant="light">Open app</orbit-button>
    </nav>
  </header>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 h-[560px] bg-[radial-gradient(ellipse_at_top,_color-mix(in_srgb,_var(--color-lime)_18%,_transparent),_transparent_60%)]"
    >
    </div>
    <div class="relative mx-auto max-w-5xl px-6 pt-24 pb-16 text-center">
      <orbit-badge label="Compose Multiplatform, visually" size="md"></orbit-badge>
      <h1 class="mt-6 text-balance text-5xl font-semibold tracking-tight text-text-primary sm:text-6xl">
        Build real apps by <span class="text-lime">dragging</span>, not coding.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-text-secondary">
        DragBuilder is a visual UI builder for Kotlin Compose Multiplatform. Design your screens, wire up
        logic, and ship native apps for Desktop, Android, iOS and Web — with clean, readable Kotlin code
        underneath.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <orbit-button href="#download" size="md">Download DragBuilder</orbit-button>
        <orbit-button
          href="https://app.dragbuilder.io"
          size="md"
          variant="secondary"
          trailing-icon="arrow-right"
          class="w-full sm:w-auto"
        >
          Try it in your browser
        </orbit-button>
      </div>
      <p class="mt-4 text-xs text-text-muted">Free to start. No credit card required.</p>
    </div>

    <!-- Product screenshot — the actual builder canvas, not a mockup -->
    <div class="relative mx-auto max-w-5xl px-6 pb-24">
      <div class="overflow-hidden rounded-card border border-border-strong bg-surface-sunken shadow-2xl">
        <Image
          src={heroBuilder}
          alt="The DragBuilder canvas: a live component palette on the left, a phone preview rendering a real Compose UI in the center, and property inspectors on the right."
          width={2000}
          height={1414}
          loading="eager"
          class="w-full"
        />
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="mx-auto max-w-6xl px-6 py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-text-primary sm:text-4xl">Everything you need to ship</h2>
      <p class="mt-4 text-text-secondary">From first screen to production build, without leaving the canvas.</p>
    </div>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <orbit-card>
            <h3 class="font-semibold text-text-primary">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary">{f.body}</p>
          </orbit-card>
        ))
      }
    </div>
  </section>

  <!-- Download -->
  <section id="download" class="border-t border-border-strong bg-surface-secondary/20">
    <div class="mx-auto max-w-5xl px-6 py-24 text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-text-primary sm:text-4xl">Get DragBuilder</h2>
      <p class="mt-4 text-text-secondary">
        Available for macOS, Windows and Linux — version <span class="font-mono text-text-secondary">{releases.version}</span>.
      </p>

      <div id="download-cards" class="mt-14 grid gap-6 sm:grid-cols-3">
        <orbit-card data-os="mac" class="download-card text-left">
          <div class="text-3xl">🍎</div>
          <h3 class="mt-3 font-semibold text-text-primary">macOS</h3>
          <p class="mt-1 text-xs text-text-muted">Apple Silicon &amp; Intel</p>
          <orbit-button href={releases.mac.url} size="md" variant="secondary" leading-icon="download" class="mt-6 w-full">
            Download .dmg
          </orbit-button>
          <p class="recommended-badge mt-3 hidden text-xs font-medium text-lime">Recommended for your system</p>
        </orbit-card>

        <orbit-card data-os="windows" class="download-card text-left">
          <div class="text-3xl">🪟</div>
          <h3 class="mt-3 font-semibold text-text-primary">Windows</h3>
          <p class="mt-1 text-xs text-text-muted">Windows 10 &amp; 11 (64-bit)</p>
          <orbit-button href={releases.windows.url} size="md" variant="secondary" leading-icon="download" class="mt-6 w-full">
            Download .msi
          </orbit-button>
          <p class="recommended-badge mt-3 hidden text-xs font-medium text-lime">Recommended for your system</p>
        </orbit-card>

        <orbit-card data-os="linux" class="download-card text-left">
          <div class="text-3xl">🐧</div>
          <h3 class="mt-3 font-semibold text-text-primary">Linux</h3>
          <p class="mt-1 text-xs text-text-muted">Debian/Ubuntu &amp; Fedora/RHEL</p>
          <div class="mt-6 flex gap-2">
            <orbit-button href={releases.linux.deb.url} size="md" variant="secondary" class="flex-1">.deb</orbit-button>
            <orbit-button href={releases.linux.rpm.url} size="md" variant="secondary" class="flex-1">.rpm</orbit-button>
          </div>
          <p class="recommended-badge mt-3 hidden text-xs font-medium text-lime">Recommended for your system</p>
        </orbit-card>
      </div>

      <p class="mt-8 text-xs text-text-muted">
        Windows installer is currently unsigned — you may see a SmartScreen "unknown publisher" warning on first
        install.
      </p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-border-strong">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-10 text-sm text-text-muted sm:flex-row">
      <p>&copy; {new Date().getFullYear()} DragBuilder</p>
      <div class="flex gap-6">
        <a href="https://app.dragbuilder.io" class="hover:text-text-secondary">Open app</a>
        <a href="https://docs.dragbuilder.io" class="hover:text-text-secondary">Docs</a>
      </div>
    </div>
  </footer>

  <script>
    import '@dragbuilder-io/orbit/orbit-button.js';
    import '@dragbuilder-io/orbit/orbit-badge.js';
    import '@dragbuilder-io/orbit/orbit-card.js';

    // Progressive enhancement only — every download link already points at a real,
    // working URL server-rendered above. This just highlights the card matching the
    // visitor's OS so they don't have to think about which one to click.
    const platform = navigator.userAgent.toLowerCase();
    let detected: string | null = null;
    if (platform.includes('mac')) detected = 'mac';
    else if (platform.includes('win')) detected = 'windows';
    else if (platform.includes('linux') && !platform.includes('android')) detected = 'linux';

    if (detected) {
      const card = document.querySelector(`.download-card[data-os="${detected}"]`);
      if (card) {
        card.setAttribute('selected', '');
        card.querySelector('.recommended-badge')?.classList.remove('hidden');
      }
    }
  </script>
</Layout>
