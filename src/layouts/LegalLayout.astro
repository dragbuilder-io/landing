---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Layout title={`${title} — DragBuilder`} description={description}>
  <header class="border-b border-border-strong bg-surface/80 backdrop-blur">
    <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-text-primary">
        <span class="flex h-7 w-7 items-center justify-center rounded-[var(--radius-md)] bg-lime text-sm font-bold text-text-inverse">D</span>
        DragBuilder
      </a>
      <orbit-button href="https://app.dragbuilder.io" size="sm" variant="light">Open app</orbit-button>
    </nav>
  </header>

  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-balance text-4xl font-semibold tracking-tight text-text-primary">{title}</h1>
    <p class="mt-3 text-sm text-text-muted">Last updated: {updated}</p>
    <article class="legal mt-10">
      <slot />
    </article>
  </main>

  <footer class="border-t border-border-strong">
    <div class="mx-auto flex max-w-3xl flex-col items-center justify-between gap-4 px-6 py-10 text-sm text-text-muted sm:flex-row">
      <p>&copy; {new Date().getFullYear()} DragBuilder</p>
      <div class="flex gap-6">
        <a href="/privacy" class="hover:text-text-secondary">Privacy Policy</a>
        <a href="/terms" class="hover:text-text-secondary">Terms of Service</a>
        <a href="mailto:admin@dragbuilder.io" class="hover:text-text-secondary">Contact</a>
      </div>
    </div>
  </footer>

  <script>
    import '@dragbuilder-io/orbit/orbit-button.js';
  </script>
</Layout>

<style is:global>
  /* Prose styling driven by the same Orbit tokens the rest of the site uses — no typography
     plugin, so headings, lists and links in the legal text stay readable and on-brand. */
  .legal { color: var(--color-text-secondary); line-height: 1.75; }
  .legal h2 { margin-top: 2.5rem; margin-bottom: 0.75rem; font-size: 1.375rem; font-weight: 600; letter-spacing: -0.01em; color: var(--color-text-primary); }
  .legal h3 { margin-top: 1.5rem; margin-bottom: 0.5rem; font-size: 1.0625rem; font-weight: 600; color: var(--color-text-primary); }
  .legal p { margin-top: 0.75rem; }
  .legal ul { margin-top: 0.75rem; padding-left: 1.25rem; list-style: disc; }
  .legal li { margin-top: 0.375rem; }
  .legal a { color: var(--color-text-primary); text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }
  .legal strong { color: var(--color-text-primary); font-weight: 600; }
  .legal table { margin-top: 1rem; width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  .legal th, .legal td { border: 1px solid var(--color-surface-border-strong); padding: 0.625rem 0.75rem; text-align: left; vertical-align: top; }
  .legal th { color: var(--color-text-primary); background: var(--color-surface-sunken); font-weight: 600; }
</style>
